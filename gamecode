                            if (currentDist >= dashDist) { clearInterval(interval); triggerPrisonerCage(this.x, this.y, this.id); }
                        }, 16);
                    } else if (this.brawler.id === 'neptune') {
                        createParticles(this.x, this.y, '#0ea5e9', 30);
                        let sharkHp = 2000 * (1 + 0.02 * this.crystalsCollected); 
                        sharks.push(new Shark(this.id, this.x, this.y, this.angle, sharkHp));
                    } else if (this.brawler.id === 'samira') {
                        this.isChannelingVortex = true;
                        this.vortexTimer = 180; // 持續 3 秒
                        this.vortexTickTimer = 15; // 每 0.25 秒 (15 幀) 觸發一次傷害
                        createFloatingText(this.x, this.y - 65, "🌪️ 流沙漩渦!", "#eab308");
                        createParticles(this.x, this.y, '#eab308', 25);
                    } else if (this.brawler.id === 'yorkie') {
                        this.isYorkieDashing = true;
                        this.yorkieUltCooldown = 20; // 大招使用間隔縮短，避免衝刺結束瞬間又立即觸發
                        const dashDist = 150; const dashAngle = this.angle; const step = 15; let currentDist = 0; let hasHitTarget = false;
                        const gemMult = 1 + 0.02 * this.crystalsCollected; // 大招傷害套用寶石戰力加成
                        const interval = setInterval(() => {
                            if (!gameActive || this.isDead) { clearInterval(interval); this.isYorkieDashing = false; return; }
                            let nextX = this.x + Math.cos(dashAngle) * step, nextY = this.y + Math.sin(dashAngle) * step;
                            let hitWall = false;
                            walls.forEach(w => { if (circleRectCollide(nextX, nextY, this.radius, w)) { hitWall = true; if (w.isRock && w.hp > 0) { w.hp = 0; createParticles(w.x + w.w/2, w.y + w.h/2, '#94a3b8', 14); playSound('hit'); } } });
                            waters.forEach(wt => { if (circleRectCollide(nextX, nextY, this.radius, wt)) hitWall = true; });
                            if (hitWall) { clearInterval(interval); this.isYorkieDashing = false; return; }
                            this.x = Math.max(this.radius, Math.min(BASE_WIDTH - this.radius, nextX));
                            this.y = Math.max(this.radius, Math.min(BASE_HEIGHT - this.radius, nextY));
                            particles.push({ type: 'clawtrail', x: this.x, y: this.y, angle: dashAngle, life: 16, maxLife: 16, len: 26 });
                            if (!hasHitTarget) {
                                const enemy = players.find(p => p.id !== this.id && !p.isDead && p.invincibilityTimer <= 0);
                                if (enemy && Math.hypot(this.x - enemy.x, this.y - enemy.y) < enemy.radius + this.radius + 10) {
                                    hasHitTarget = true;
                                    if (enemy.pawMarkTimer > 0) {
                                        enemy.takeDamage(600 * gemMult, this.id, true, false);
                                        this.ultCharge = 100; // 印記撕裂：立即刷新大招
                                        createFloatingText(enemy.x, enemy.y - 45, "🐾 印記撕裂!", "#f97316");
                                    } else {
                                        enemy.takeDamage(500 * gemMult, this.id, true, false);
                                        this.ultCharge = Math.min(100, this.ultCharge + 50);
                                    }
                                    createParticles(enemy.x, enemy.y, '#fef08a', 22);
                                }
                            }
                            currentDist += step;
                            if (currentDist >= dashDist) { clearInterval(interval); this.isYorkieDashing = false; }
                        }, 16);
                    } else if (this.brawler.id === 'vampire') {
                        this.isBatForm = true;
                        this.batFormTimer = 120; // 持續 2 秒
                        this.invincibilityTimer = 120; // 絕對無敵，免疫所有傷害/子彈/控制效果
                        createFloatingText(this.x, this.y - 65, "🦇 夜幕蝠化!", "#881337");
                        createParticles(this.x, this.y, '#881337', 25);
                    }
                }
            }

            draw() {
                if (this.isDead) {
                    ctx.save(); ctx.font = '30px Arial'; ctx.textAlign = 'center'; ctx.fillText('🪦', this.x, this.y); ctx.fillStyle = '#ef4444'; ctx.font = '16px Arial'; ctx.fillText(Math.ceil(this.respawnTimer / 60), this.x, this.y - 20); ctx.restore();
                    return;
                }
                const otherPlayer = players.find(p => p.id !== this.id);
                let opacity = 1.0;
                if (this.isHiding && this.revealTimer <= 0) {
                    if (otherPlayer && !otherPlayer.isDead && otherPlayer.isHiding && otherPlayer.currentBush === this.currentBush) {
                        opacity = 0.85; // 雙方在同一塊草叢裡，維持看得到彼此
                    } else {
                        opacity = 0.08; // 敵人不在同一塊草叢 (或沒躲) - 幾乎完全隱形
                    }
                }

                ctx.save(); ctx.globalAlpha = opacity; ctx.translate(this.x, this.y);

                // 法師大招吟唱動畫：旋轉火焰光環 + 脈動火光 + 上升火花 + 五芒星法環
                if (this.isChannelingMageUlt) {
                    const ratio = this.mageUltTimer / 180;
                    const pulse = 1 + Math.sin(Date.now() / 90) * 0.12;

                    // 底部脈動火光暈染
                    const glowGrad = ctx.createRadialGradient(0, 0, this.radius * 0.3, 0, 0, this.radius * 1.8 * pulse);
                    glowGrad.addColorStop(0, 'rgba(249,115,22,0.55)');
                    glowGrad.addColorStop(1, 'rgba(249,115,22,0)');
                    ctx.fillStyle = glowGrad;
                    ctx.beginPath(); ctx.arc(0, 0, this.radius * 1.8 * pulse, 0, Math.PI * 2); ctx.fill();

                    // 地面五芒星法陣 (持續緩慢旋轉)
                    ctx.save();
                    ctx.rotate(Date.now() / 180);
                    const starOuterR = this.radius + 34;
                    const starPoints = [];
                    for (let i = 0; i < 5; i++) {
                        const ang = -Math.PI / 2 + i * (Math.PI * 2 / 5);
                        starPoints.push([Math.cos(ang) * starOuterR, Math.sin(ang) * starOuterR]);
                    }
                    ctx.strokeStyle = 'rgba(239,68,68,0.85)'; ctx.lineWidth = 2;
                    ctx.shadowColor = '#ef4444'; ctx.shadowBlur = 8;
                    ctx.beginPath();
                    for (let i = 0; i <= 5; i++) {
                        const idx = (i * 2) % 5;
                        const [px, py] = starPoints[idx];
                        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
                    }
                    ctx.closePath(); ctx.stroke();
                    // 外圍法環雙圈
                    ctx.shadowBlur = 0;
                    ctx.strokeStyle = 'rgba(249,115,22,0.6)'; ctx.lineWidth = 1.5;
                    ctx.beginPath(); ctx.arc(0, 0, starOuterR + 5, 0, Math.PI * 2); ctx.stroke();
                    ctx.beginPath(); ctx.arc(0, 0, starOuterR - 6, 0, Math.PI * 2); ctx.stroke();
                    ctx.restore();

                    // 兩層反向旋轉的火焰符文環
                    ctx.save(); ctx.rotate(Date.now() / 260);
                    ctx.strokeStyle = 'rgba(239,68,68,0.85)'; ctx.lineWidth = 2.5; ctx.setLineDash([6, 10]);
                    ctx.beginPath(); ctx.arc(0, 0, this.radius + 16, 0, Math.PI * 2); ctx.stroke();
                    ctx.restore();
                    ctx.save(); ctx.rotate(-Date.now() / 180);
                    ctx.strokeStyle = 'rgba(249,115,22,0.7)'; ctx.lineWidth = 2; ctx.setLineDash([3, 7]);
                    ctx.beginPath(); ctx.arc(0, 0, this.radius + 24, 0, Math.PI * 2); ctx.stroke();
                    ctx.restore();
                    ctx.setLineDash([]);

                    // 上升火花微粒 (低機率避免過於密集)
                    if (Math.random() < 0.5) {
                        const sparkAngle = Math.random() * Math.PI * 2;
                        const sparkDist = this.radius * (0.6 + Math.random() * 0.8);
                        createParticles(this.x + Math.cos(sparkAngle) * sparkDist, this.y + Math.sin(sparkAngle) * sparkDist, '#f97316', 1);
                    }

                    // 詠唱進度條
                    const chargeBarW = 40, chargeBarH = 6;
                    ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(-chargeBarW/2, -this.radius - 20, chargeBarW, chargeBarH);
                    ctx.fillStyle = '#ef4444'; ctx.fillRect(-chargeBarW/2, -this.radius - 20, chargeBarW * ratio, chargeBarH);
                    ctx.strokeStyle = '#fff'; ctx.strokeRect(-chargeBarW/2, -this.radius - 20, chargeBarW, chargeBarH);
                }

                // 漠海舞姬大招：流沙漩渦 (狂沙龍捲風動畫，強化版) + 護盾特效
                if (this.isChannelingVortex) {
                    const vr = 180;
                    const vRatio = this.vortexTimer / 180;
                    ctx.save();
                    const vGrad = ctx.createRadialGradient(0, 0, vr * 0.1, 0, 0, vr);
                    vGrad.addColorStop(0, 'rgba(202,138,4,0.10)');
                    vGrad.addColorStop(0.5, 'rgba(234,179,8,0.24)');
                    vGrad.addColorStop(0.85, 'rgba(217,119,6,0.18)');
                    vGrad.addColorStop(1, 'rgba(234,179,8,0)');
                    ctx.fillStyle = vGrad;
                    ctx.beginPath(); ctx.arc(0, 0, vr, 0, Math.PI * 2); ctx.fill();
                    // 多層強化沙塵漩渦環 (5層，色彩更濃烈、轉速更快)
                    for (let i = 0; i < 5; i++) {
                        ctx.save();
                        ctx.rotate((Date.now() / (140 - i * 18)) * (i % 2 === 0 ? 1 : -1));
                        ctx.strokeStyle = `rgba(253,224,71,${0.7 - i * 0.11})`; ctx.lineWidth = 3.5 - i * 0.5;
                        ctx.setLineDash([14, 10]);
                        ctx.beginPath(); ctx.arc(0, 0, vr * (0.25 + i * 0.18), 0, Math.PI * 1.75); ctx.stroke();
                        ctx.restore();
                    }
                    ctx.setLineDash([]);
                    // 邊緣沙塵爆裂圈
                    ctx.strokeStyle = 'rgba(250,204,21,0.5)'; ctx.lineWidth = 2;
                    ctx.beginPath(); ctx.arc(0, 0, vr * (0.92 + Math.sin(Date.now()/150) * 0.05), 0, Math.PI * 2); ctx.stroke();
                    ctx.restore();
                    // 沙塵微粒 (加密頻率)
                    if (Math.random() < 0.85) {
                        const va = Math.random() * Math.PI * 2, vd = Math.random() * vr;
                        createParticles(this.x + Math.cos(va) * vd, this.y + Math.sin(va) * vd, Math.random() < 0.5 ? '#eab308' : '#fde047', 1);
                    }

                    // 護盾特效：六角能量護盾罩住舞姬本體 (呼應 30% 減傷)
                    ctx.save();
                    const shieldPulse = 1 + Math.sin(Date.now() / 200) * 0.06;
                    ctx.rotate(Date.now() / 900);
                    ctx.strokeStyle = 'rgba(253,224,71,0.9)'; ctx.lineWidth = 2.5;
                    ctx.shadowColor = '#facc15'; ctx.shadowBlur = 10;
                    ctx.beginPath();
                    for (let i = 0; i <= 6; i++) {
                        const ang = i * (Math.PI * 2 / 6);
                        const sx = Math.cos(ang) * (this.radius + 14) * shieldPulse, sy = Math.sin(ang) * (this.radius + 14) * shieldPulse;
                        if (i === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
                    }
                    ctx.closePath(); ctx.stroke();
                    ctx.fillStyle = 'rgba(253,224,71,0.08)'; ctx.fill();
                    ctx.restore();

                    const vBarW = 40, vBarH = 6;
                    ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(-vBarW/2, -this.radius - 20, vBarW, vBarH);
                    ctx.fillStyle = '#eab308'; ctx.fillRect(-vBarW/2, -this.radius - 20, vBarW * vRatio, vBarH);
                    ctx.strokeStyle = '#fff'; ctx.strokeRect(-vBarW/2, -this.radius - 20, vBarW, vBarH);
                }

                // 血魅伯爵：夜幕蝠化視覺 (暗紅光暈 + 環繞蝙蝠殘影 + 倒數條)
                if (this.isBatForm) {
                    const batRatio = this.batFormTimer / 120;
                    ctx.save();
                    const batGlow = ctx.createRadialGradient(0, 0, this.radius * 0.4, 0, 0, this.radius * 1.7);
                    batGlow.addColorStop(0, 'rgba(136,19,55,0.35)');
                    batGlow.addColorStop(1, 'rgba(136,19,55,0)');
                    ctx.fillStyle = batGlow;
                    ctx.beginPath(); ctx.arc(0, 0, this.radius * 1.7, 0, Math.PI * 2); ctx.fill();
                    const batCount = 3;
                    for (let i = 0; i < batCount; i++) {
                        const bAng = (Date.now() / 260) * (i % 2 === 0 ? 1 : -1) + (i / batCount) * Math.PI * 2;
                        const bR = this.radius + 20;
                        ctx.font = '26px Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                        ctx.fillText('🦇', Math.cos(bAng) * bR, Math.sin(bAng) * bR);
                    }
                    ctx.textBaseline = 'alphabetic';
                    ctx.restore();
                    const bBarW = 40, bBarH = 6;
                    ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(-bBarW/2, -this.radius - 20, bBarW, bBarH);
                    ctx.fillStyle = '#881337'; ctx.fillRect(-bBarW/2, -this.radius - 20, bBarW * (1 - batRatio), bBarH);
                    ctx.strokeStyle = '#fff'; ctx.strokeRect(-bBarW/2, -this.radius - 20, bBarW, bBarH);
                }

                // 閃電遊俠：超載電磁領域 BUFF 期間的閃電環繞特效
                if (this.isRangerUlt) {
                    ctx.save();
                    const boltRingCount = 2;
                    for (let ring = 0; ring < boltRingCount; ring++) {
                        ctx.save();
                        ctx.rotate((Date.now() / (140 - ring * 30)) * (ring % 2 === 0 ? 1 : -1));
                        const boltR = this.radius + 10 + ring * 9;
                        const spikes = 8;
                        ctx.strokeStyle = ring === 0 ? 'rgba(224,242,254,0.9)' : 'rgba(96,165,250,0.7)';
                        ctx.lineWidth = 2; ctx.shadowColor = '#60a5fa'; ctx.shadowBlur = 10;
                        ctx.beginPath();
                        for (let s = 0; s < spikes; s++) {
                            const ang = (s / spikes) * Math.PI * 2;
                            const jitter = (Math.sin(Date.now() / 60 + s * 3) * 3);
                            const r1 = boltR + jitter, r2 = boltR - 4 + jitter;
                            const x1 = Math.cos(ang) * r1, y1 = Math.sin(ang) * r1;
                            const x2 = Math.cos(ang + 0.18) * r2, y2 = Math.sin(ang + 0.18) * r2;
                            if (s === 0) ctx.moveTo(x1, y1); else ctx.lineTo(x1, y1);
                            ctx.lineTo(x2, y2);
                        }
                        ctx.closePath(); ctx.stroke();
                        ctx.restore();
                    }
                    ctx.restore();
                    if (Math.random() < 0.4) createParticles(this.x, this.y, '#60a5fa', 1);
                }
                
                if (this.damageReductionTimer > 0) {
                    ctx.beginPath(); ctx.arc(0, 0, this.radius + 12, 0, Math.PI * 2);
                    ctx.strokeStyle = "rgba(168, 162, 158, 0.9)"; ctx.lineWidth = 4; ctx.setLineDash([8, 5]); ctx.stroke(); ctx.setLineDash([]);
                }
                
                if (this.invincibilityTimer > 0) { 
                    ctx.beginPath(); ctx.arc(0, 0, this.radius + 10, 0, Math.PI * 2); ctx.fillStyle = "rgba(250, 204, 21, 0.3)"; ctx.fill(); ctx.strokeStyle = "#facc15"; ctx.lineWidth = 3; ctx.stroke(); 
                }

                ctx.save();
                ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.clip();

                if (this.img && this.img.complete && this.img.naturalWidth > 0) {
                    const aspect = this.img.naturalWidth / this.img.naturalHeight;
                    let drawW = this.radius * 2, drawH = this.radius * 2;
                    let offsetX = -this.radius, offsetY = -this.radius;
                    if (aspect > 1) { drawW = drawH * aspect; offsetX = -drawW / 2; } 
                    else { drawH = drawW / aspect; offsetY = -drawH / 2; }
                    ctx.drawImage(this.img, offsetX, offsetY, drawW, drawH);
                } else {
                    ctx.fillStyle = this.color + "22"; ctx.fill();
                    ctx.font = `${this.radius * 1.5}px Arial`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(this.brawler.emoji, 0, 0);
                }
                ctx.restore(); 

                // 血魅伯爵：夜幕蝠化期間整體覆蓋血色濾鏡
                if (this.isBatForm) {
                    ctx.save();
                    ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.clip();
                    ctx.fillStyle = 'rgba(190, 18, 60, 0.45)';
                    ctx.fillRect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
                    ctx.restore();
                }

                ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.strokeStyle = this.color; ctx.lineWidth = 3; ctx.stroke();
                ctx.rotate(this.angle); ctx.beginPath(); ctx.moveTo(this.radius - 2, -6); ctx.lineTo(this.radius + 8, 0); ctx.lineTo(this.radius - 2, 6); ctx.fillStyle = this.color; ctx.fill(); ctx.rotate(-this.angle);
                
                if (this.isConfused) { ctx.font = '20px Arial'; ctx.fillText('🌀', 0, -this.radius - 12); }
                if (this.isStunned) { ctx.font = '20px Arial'; ctx.fillText('💫', 0, -this.radius - 12); }
                if (this.dotTicks > 0) { ctx.font = '16px Arial'; ctx.fillText('☠️', 15, -this.radius - 5); }
                ctx.restore();

                if (this.isCharging) {
                    ctx.save(); ctx.globalAlpha = opacity; ctx.translate(this.x, this.y);
                    let holdTime = (Date.now() - this.chargeStartTime) / 1000;
                    let ratio = 0; if (holdTime > 0.5) ratio = Math.min((holdTime - 0.5) / 1.5, 1.0);
                    
                    const chargeBarW = 40, chargeBarH = 6;
                    ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(-chargeBarW/2, -this.radius - 40, chargeBarW, chargeBarH);
                    ctx.fillStyle = '#06b6d4'; ctx.fillRect(-chargeBarW/2, -this.radius - 40, chargeBarW * ratio, chargeBarH);
                    ctx.strokeStyle = '#fff'; ctx.strokeRect(-chargeBarW/2, -this.radius - 40, chargeBarW, chargeBarH);
                    ctx.restore();
                }

                if (this.isSpraying) {
                    ctx.save(); ctx.globalAlpha = opacity; ctx.translate(this.x, this.y); ctx.rotate(this.angle);
                    const isCrafter = this.brawler.id === 'crafter';
                    const sprayRange = isCrafter ? 280 : 320;
                    const sprayWidth = isCrafter ? 25 : 15;
                    const grad = ctx.createLinearGradient(0, 0, sprayRange, 0);
                    if (isCrafter) { grad.addColorStop(0, "rgba(244, 63, 94, 0.8)"); grad.addColorStop(0.5, "rgba(251, 113, 133, 0.5)"); grad.addColorStop(1, "rgba(251, 113, 133, 0.0)"); }
                    else { grad.addColorStop(0, "rgba(14, 165, 233, 0.8)"); grad.addColorStop(0.5, "rgba(56, 189, 248, 0.5)"); grad.addColorStop(1, "rgba(56, 189, 248, 0.0)"); }
                    
                    ctx.fillStyle = grad; ctx.beginPath();
                    ctx.moveTo(10, -5); ctx.lineTo(sprayRange, -sprayWidth); ctx.lineTo(sprayRange, sprayWidth); ctx.lineTo(10, 5);
                    ctx.closePath(); ctx.fill(); ctx.restore();

                    if (Math.random() < 0.6) {
                        const pAngle = this.angle + (Math.random() * (isCrafter ? 0.3 : 0.15) - (isCrafter ? 0.15 : 0.075)); 
                        const pDist = Math.random() * (sprayRange - 20) + 20;
                        createParticles(this.x + Math.cos(pAngle) * pDist, this.y + Math.sin(pAngle) * pDist, isCrafter ? '#fb7185' : '#38bdf8', 1);
                    }
                }

                // 畫法師大招位置不在血條上方，將血條移低
                const barYOffset = this.isChannelingMageUlt ? -this.radius - 32 : -this.radius - 20;
                ctx.save(); ctx.globalAlpha = opacity; ctx.translate(this.x, this.y);
                const barW = 50, barH = 6; ctx.fillStyle = '#1e293b'; ctx.fillRect(-barW/2, barYOffset, barW, barH); ctx.fillStyle = (this.hp/this.maxHp) > 0.4 ? '#22c55e' : '#ef4444'; ctx.fillRect(-barW/2, barYOffset, barW * (this.hp/this.maxHp), barH); ctx.strokeStyle = '#020617'; ctx.lineWidth = 1; ctx.strokeRect(-barW/2, barYOffset, barW, barH);
                ctx.font = 'bold 9px Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.lineWidth = 2.5; ctx.strokeStyle = 'rgba(0,0,0,0.85)'; ctx.strokeText(`${Math.max(0, Math.round(this.hp))}`, 0, barYOffset + barH/2 + 0.5);
                ctx.fillStyle = '#ffffff'; ctx.fillText(`${Math.max(0, Math.round(this.hp))}`, 0, barYOffset + barH/2 + 0.5);
                ctx.textBaseline = 'alphabetic';
                for (let i = 0; i < 3; i++) { ctx.fillStyle = i < this.ammo ? '#f59e0b' : '#475569'; ctx.fillRect(-barW/2 + i * 18, barYOffset - 8, 14, 4); }
                if (this.freezeValue > 0) { ctx.fillStyle = "rgba(56, 189, 248, 0.9)"; ctx.font = "bold 10px Arial"; ctx.textAlign = "center"; ctx.fillText(`❄️ ${Math.floor(this.freezeValue)}%`, 0, barYOffset - 14); }
                if (this.pawMarkTimer > 0) { ctx.font = "42px Arial"; ctx.textAlign = "center"; ctx.fillText("🐾", 0, barYOffset - 38); }

                // 大招已集滿：細緻金色呼吸光環提醒 (縮放幅度小，避免草叢中過於顯眼)
                if (this.ultCharge >= 100 && !this.isDead) {
                    const ultPulse = 1 + Math.sin(Date.now() / 200) * 0.035;
                    ctx.save();
                    ctx.beginPath(); ctx.arc(0, 0, (this.radius + 5) * ultPulse, 0, Math.PI * 2);
                    ctx.strokeStyle = 'rgba(250, 204, 21, 0.75)'; ctx.lineWidth = 1.5;
                    ctx.stroke();
                    ctx.restore();
                }
                ctx.restore();
            }
        }

        // ==========================================
        // 6. 子彈與投射物 (Bullet)
        // ==========================================
        class Bullet {
            constructor(ownerId, x, y, angle, speed, damage, maxRange, color, radius=8, isPiercing=false, effect=null, isUltimate=false) {
                this.ownerId = ownerId; this.x = x; this.y = y; this.vx = Math.cos(angle) * speed; this.vy = Math.sin(angle) * speed; this.damage = damage; this.maxRange = maxRange; this.color = color; this.radius = radius; this.isPiercing = isPiercing; this.effect = effect; this.isUltimate = isUltimate; this.distanceTraveled = 0; this.hitPlayers = []; 
                this.returning = false;
            }
            update() {
                // ===== 漠海舞姬專屬：迴旋金沙刃 (去程不可穿牆/可貫穿敵人，飛滿射程或撞牆後折返，回程可穿牆並追蹤主人) =====
                if (this.effect === 'boomerang') {
                    if (!this.returning) {
                        this.x += this.vx; this.y += this.vy; this.distanceTraveled += Math.hypot(this.vx, this.vy);
                        let cageAbsorbed = false;
                        prisonerCages.forEach(cage => {
